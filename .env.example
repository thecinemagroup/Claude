# --- Claude (research) ---
ANTHROPIC_API_KEY=

# --- Grok (execution) ---
XAI_API_KEY=
XAI_MODEL=grok-4

# --- Robinhood Crypto Trading API (robinhood.com/account/crypto -> API Trading) ---
ROBINHOOD_API_KEY=
# Base64-encoded Ed25519 private key (32-byte seed) generated when you registered the API key
ROBINHOOD_PRIVATE_KEY=

# --- Risk controls ---
# Orders are only sent to Robinhood when this is exactly "true". Anything else = dry run.
LIVE_TRADING=false
# Create this file (e.g. `touch KILL`) to halt all order placement immediately.
KILL_SWITCH_FILE=KILL
SYMBOLS=BTC-USD,ETH-USD,SOL-USD
MAX_ORDER_USD=50
MAX_DAILY_USD=200
MIN_CONFIDENCE=0.7
# Minutes between research/execute cycles when running continuously
CYCLE_MINUTES=60
